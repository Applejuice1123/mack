+
+void ggml_metal_print_timing_report(ggml_metal_t ctx) {
+  if (!ctx->use_timing) {
+    return;
+  }
+
+  GGML_LOG_INFO("\n");
+  GGML_LOG_INFO("=== Metal Timing Report (compute call %d) ===\n", ctx->timing_frame);
+
+  // Command buffer GPU times (actual measured GPU wall time per command buffer)
+  if (ctx->timing_count > 0) {
+    GGML_LOG_INFO("\nGPU Command Buffer Times:\n");
+    GGML_LOG_INFO("  %-24s  %12s\n", "Buffer", "GPU Time (ms)");
+    GGML_LOG_INFO("  %-24s  %12s\n", "------------------------", "------------");
+
+    double total_gpu = 0.0;
+    for (int i = 0; i < ctx->timing_count; i++) {
+      GGML_LOG_INFO("  %-24s  %12.3f\n",
+                    ctx->timing_history[i].name,
+                    ctx->timing_history[i].gpu_time_ms);
+      total_gpu += ctx->timing_history[i].gpu_time_ms;
+    }
+    GGML_LOG_INFO("  %-24s  %12.3f\n", "TOTAL GPU", total_gpu);
+  }
+
+  // Per-op timing breakdown
+  bool any_op = false;
+  for (int i = 0; i < GGML_OP_COUNT; i++) {
+    if (ctx->op_timing_count[i] > 0) { any_op = true; break; }
+  }
+  if (any_op) {
+    if (ctx->op_timing_is_gpu) {
+      GGML_LOG_INFO("\nGPU Time by Op (hardware counter samples):\n");
+    } else {
+      GGML_LOG_INFO("\nCPU Encoding Time by Op (proxy — GPU counter sampling not available):\n");
+    }
+    GGML_LOG_INFO("  %-24s  %8s  %12s  %12s\n", "Op", "Count", "Avg (ms)", "Total (ms)");
+    GGML_LOG_INFO("  %-24s  %8s  %12s  %12s\n",
+                  "------------------------", "--------", "------------", "------------");
+
+    double grand_total = 0.0;
+    for (int i = 0; i < GGML_OP_COUNT; i++) {
+      if (ctx->op_timing_count[i] == 0) { continue; }
+      double total_ms = ctx->op_timing_gpu_time[i];
+      double avg_ms   = total_ms / ctx->op_timing_count[i];
+      grand_total    += total_ms;
+      GGML_LOG_INFO("  %-24s  %8d  %12.4f  %12.4f\n",
+                    ggml_op_name((enum ggml_op)i),
+                    ctx->op_timing_count[i], avg_ms, total_ms);
+    }
+    GGML_LOG_INFO("  %-24s  %8s  %12s  %12.4f\n",
+                  "TOTAL", "", "", grand_total);
+  }
+
+  GGML_LOG_INFO("\n");
+
+  // Reset for next call
+  ctx->timing_count = 0;
+  ctx->timing_frame++;
+  ctx->op_timing_is_gpu = false;
+  memset(ctx->op_timing_gpu_time, 0, sizeof(ctx->op_timing_gpu_time));
+  memset(ctx->op_timing_count,    0, sizeof(ctx->op_timing_count));
 }
