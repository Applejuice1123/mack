+// ---------------------------------------------------------------------------
+// MTLCounterSampleBuffer – per-op GPU timestamp profiling
+// ---------------------------------------------------------------------------
+
+bool ggml_metal_device_supports_ts_sampling(ggml_metal_device_t dev) {
+    id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(dev);
+
+    // need the timestamp counter set
+    bool has_ts_set = false;
+    for (id<MTLCounterSet> cs in device.counterSets) {
+        if ([cs.name isEqualToString:MTLCommonCounterSetTimestamp]) {
+            has_ts_set = true;
+            break;
+        }
+    }
+    if (!has_ts_set) { return false; }
+
+    // sampleCountersInBuffer:atSampleIndex:withBarrier: on MTLComputeCommandEncoder
+    // requires dispatch-boundary support; stage-boundary alone is insufficient
+    // (the method will runtime-assert on devices that only have stage support)
+    return [device supportsCounterSampling:MTLCounterSamplingPointAtDispatchBoundary];
+}
+
+ggml_metal_csb_t ggml_metal_csb_create(ggml_metal_device_t dev, int n_samples) {
+    id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(dev);
+
+    id<MTLCounterSet> ts_set = nil;
+    for (id<MTLCounterSet> cs in device.counterSets) {
+        if ([cs.name isEqualToString:MTLCommonCounterSetTimestamp]) {
+            ts_set = cs;
+            break;
+        }
+    }
+    if (!ts_set) { return NULL; }
+
+    MTLCounterSampleBufferDescriptor * desc = [[MTLCounterSampleBufferDescriptor alloc] init];
+    desc.counterSet  = ts_set;
+    desc.storageMode = MTLStorageModeShared; // unified memory – no blit needed to read
+    desc.sampleCount = (NSUInteger) n_samples;
+
+    NSError * err = nil;
+    id<MTLCounterSampleBuffer> csb = [device newCounterSampleBufferWithDescriptor:desc error:&err];
+    [desc release];
+
+    if (!csb) {
+        GGML_LOG_WARN("%s: failed to create MTLCounterSampleBuffer: %s\n", __func__,
+                      err ? [[err localizedDescription] UTF8String] : "unknown error");
+        return NULL;
+    }
+
+    [csb retain];
+    return (ggml_metal_csb_t) csb;
+}
+
+void ggml_metal_csb_free(ggml_metal_csb_t csb) {
+    if (csb) {
+        [(id<MTLCounterSampleBuffer>) csb release];
+    }
+}
+
+void ggml_metal_encoder_sample_ts(ggml_metal_encoder_t enc, ggml_metal_csb_t csb, int sample_idx) {
+    [(enc->obj) sampleCountersInBuffer:(id<MTLCounterSampleBuffer>) csb
+                         atSampleIndex:(NSUInteger) sample_idx
+                           withBarrier:YES];
+}
+
+bool ggml_metal_device_supports_stage_ts_sampling(ggml_metal_device_t dev) {
+    id<MTLDevice> device = (id<MTLDevice>) ggml_metal_device_get_obj(dev);
+
+    bool has_ts_set = false;
+    for (id<MTLCounterSet> cs in device.counterSets) {
+        if ([cs.name isEqualToString:MTLCommonCounterSetTimestamp]) {
+            has_ts_set = true;
+            break;
+        }
+    }
+    if (!has_ts_set) { return false; }
+
+    return [device supportsCounterSampling:MTLCounterSamplingPointAtStageBoundary];
+}
+
+ggml_metal_encoder_t ggml_metal_encoder_init_with_csb(ggml_metal_cmd_buf_t cmd_buf_raw,
+                                                       ggml_metal_csb_t     csb,
+                                                       int                  start_idx,
+                                                       int                  end_idx) {
+    ggml_metal_encoder_t res = calloc(1, sizeof(struct ggml_metal_encoder));
+
+    id<MTLCommandBuffer> cmd_buf = (id<MTLCommandBuffer>) cmd_buf_raw;
+
+    MTLComputePassDescriptor * desc = [MTLComputePassDescriptor computePassDescriptor];
+    MTLComputePassSampleBufferAttachmentDescriptor * att = desc.sampleBufferAttachments[0];
+    att.sampleBuffer              = (id<MTLCounterSampleBuffer>) csb;
+    att.startOfEncoderSampleIndex = (NSUInteger) start_idx;
+    att.endOfEncoderSampleIndex   = (NSUInteger) end_idx;
+
+    res->obj = [cmd_buf computeCommandEncoderWithDescriptor:desc];
+    [res->obj retain];
+
+    return res;
+}
+
+uint64_t * ggml_metal_csb_resolve(ggml_metal_csb_t csb, int n_samples) {
+    id<MTLCounterSampleBuffer> buf = (id<MTLCounterSampleBuffer>) csb;
+
+    NSData * data = [buf resolveCounterRange:NSMakeRange(0, (NSUInteger) n_samples)];
+    if (!data || (NSInteger) data.length < n_samples * (NSInteger) sizeof(uint64_t)) {
+        return NULL;
+    }
+
+    uint64_t * result = (uint64_t *) malloc((size_t) n_samples * sizeof(uint64_t));
+    memcpy(result, data.bytes, (size_t) n_samples * sizeof(uint64_t));
+    return result;
+}
