+void ggml_backend_metal_get_attention_importances(ggml_backend_t backend, struct ggml_tensor * tensor, float * data) {
+    if (tensor->op != GGML_OP_FLASH_ATTN_EXT) {
+        return;
+    }
+
+    // Calculate the offset to the importance vector (vector_B)
+    // This must strictly match the offset calculation in ggml-metal-ops.cpp
+    size_t offs = ggml_nbytes(tensor);
+    offs += ggml_metal_op_flash_attn_ext_extra_pad(tensor);
+    offs += ggml_metal_op_flash_attn_ext_extra_blk(tensor);
+    offs += ggml_metal_op_flash_attn_ext_extra_tmp(tensor);
+
+    // debug scores start here
+    const int32_t n_head = tensor->src[0]->ne[2] * tensor->src[0]->ne[3];
+    const int32_t ne11   = tensor->src[1]->ne[1];
+
+    // vector_B starts after the raw scores
+    offs += (size_t) n_head * ne11 * sizeof(float);
+
+    size_t size = ne11 * sizeof(float);
+
+    // Read using the generic backend API with our calculated offset
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (buf && buf->iface.get_tensor) {
+        buf->iface.get_tensor(buf, tensor, data, offs, size);
+    }
+
+    GGML_UNUSED(backend);
+}
