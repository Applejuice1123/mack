+constant int32_t FC_attention_reduction_n_heads [[function_constant(FC_ATTENTION_REDUCTION + 1)]];
+
+kernel void kernel_attention_reduction(
+    device const float * debug_attention_scores [[buffer(1)]],
+    device       float * vector_B               [[buffer(2)]],
+    uint3 tgpig [[threadgroup_position_in_grid]],
+    uint  tiitg [[thread_index_in_threadgroup]],
+    uint  tiisg [[thread_index_in_simdgroup]],
+    uint  sgitg [[simdgroup_index_in_threadgroup]]) 
+{
+    // The objective: Average the attention scores for a single token across all heads.
+    // We assign ONE THREADGROUP to process ONE TOKEN.
+    // tgpig[0] represents the Token Index (Token I).
+    const int token_idx = tgpig[0];
+    
+    // Safety check
+    if (token_idx >= FC_attention_reduction_seq_len) return;
+    // Shared memory (SRAM) for the final stage of the reduction tree
+    // Apple Silicon max threadgroup size is usually 1024 (32 SIMD groups)
+    threadgroup float shared_sums[32]; 
+    float local_sum = 0.0f;
+    // 1. Each thread loops through its assigned heads and accumulates a local sum
+    // (e.g., if there are 64 heads and 32 threads, each thread handles 2 heads)
+    for (int h = tiitg; h < FC_attention_reduction_n_heads; h += 32) { // Assuming threadgroup size is 32 for simplicity, adjust block size from C++
+        // Calculate the flattened index in the input array
+        // Data layout is [head][token_idx]
+        int flat_idx = h * FC_attention_reduction_seq_len + token_idx; 
+        local_sum += debug_attention_scores[flat_idx];
+    }
+    // 2. Hardware-Level Reduction (The fast path!)
+    // Apple Metal natively supports SIMD-group reductions without shared memory.
+    // This instantly sums the values across all 32 threads in the warp.
+    float simd_sum_val = simd_sum(local_sum);
+    // 3. If we launched more than 1 SIMD group (e.g. 256 threads = 8 SIMD groups),
+    // we use shared memory for the final Brent-Kung tree steps.
+    if (tiisg == 0) {
+        shared_sums[sgitg] = simd_sum_val;
+    }
+    // Wait for all SIMD groups to finish writing to shared_sums
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // 4. Final Reduction by SIMD group 0
+    if (sgitg == 0) {
+        // Read the partial sums from the other SIMD groups
+        float final_sum = (tiisg < 32 /* or num_simd_groups */) ? shared_sums[tiisg] : 0.0f;
+        
+        // One last hardware reduction!
+        final_sum = simd_sum(final_sum);
+        // 5. The Root Thread writes the final average to VRAM
