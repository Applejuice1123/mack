+void ggml_metal_enable_timing(ggml_metal_t ctx, bool enabled) {
+  ctx->use_timing = enabled;
+  if (enabled) {
+    memset(ctx->op_timing_gpu_time, 0, sizeof(ctx->op_timing_gpu_time));
+    memset(ctx->op_timing_count, 0, sizeof(ctx->op_timing_count));
